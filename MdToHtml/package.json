{
  "name": "mdtohtml-pro",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "main": "electron/main.js",
  "description": "A professional offline Markdown to HTML converter and editor with smart layout and local file management.",
  "author": {
    "name": "MdToHtml Team",
    "email": "support@mdtohtml.com"
  },
  "scripts": {
    "dev": "next dev",
    "build": "cross-env NEXT_EXPORT=true next build && node scripts/post-build.js",
    "build:next": "cross-env NEXT_EXPORT=true next build",
    "start": "next start",
    "lint": "next lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:ci": "jest --ci --coverage",
    "test:e2e": "node scripts/verify-static-build.js",
    "dev:electron": "concurrently \"cross-env NEXT_PUBLIC_IS_ELECTRON=true next dev\" \"wait-on tcp:3000 && electron .\"",
    "build:electron": "cross-env ELECTRON_BUILDER_BINARIES_MIRROR=https://github.com/electron-userland/electron-builder-binaries/releases/download/ electron-builder --dir --win portable",
    "preview:electron": "npm run build:electron-pre && cross-env FORCE_SERVE=true electron ."
  },
  "build": {
    "appId": "com.mdtohtml.pro",
    "productName": "MdToHtml Pro",
    "files": [
      "electron/**/*",
      "out/**/*",
      "package.json",
      "config.json"
    ],
    "extraFiles": [
      "config.json"
    ],
    "directories": {
      "output": "c:\\Users\\86171\\Desktop\\MdToHmtl\\release"
    },
    "asar": false,
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "${productName}-Portable-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    }
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language-data": "^6.5.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@uiw/codemirror-theme-github": "^4.25.4",
    "@uiw/react-codemirror": "^4.25.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "express": "^5.2.1",
    "fs-extra": "^11.3.3",
    "get-port": "^7.1.0",
    "gray-matter": "^4.0.3",
    "katex": "^0.16.28",
    "lucide-react": "^0.330.0",
    "multer": "^2.0.2",
    "next": "14.1.0",
    "react": "^18",
    "react-dom": "^18",
    "react-markdown": "^9.0.1",
    "rehype-katex": "^7.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "swr": "^2.4.0",
    "tailwind-merge": "^2.6.1",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.0.1",
    "cheerio": "^1.2.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^40.6.0",
    "electron-builder": "^26.8.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.1.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "jsdom": "^28.1.0",
    "postcss": "^8",
    "tailwindcss": "^3.3.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5",
    "wait-on": "^9.0.4"
  }
}
